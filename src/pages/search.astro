---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { getLang, useT } from '../i18n';

// Used by /search/ and /fr/search/. Pagefind keeps one index per language (from <html lang>).
const bundlePath = withBase('/pagefind/');
const lang = getLang(Astro.url);
const fr = lang === 'fr';
const t = useT(lang);
---

<BaseLayout
  title={t('search.title')}
  description={fr ? `Rechercher dans les études de cas et les notes de ${SITE.title}, Data Analyst.` : `Search the case studies and notes of ${SITE.title}, Data Analyst.`}
>
  <link slot="head" rel="stylesheet" href={`${bundlePath}pagefind-ui.css`} />
  <section class="page-head section">
    <p class="eyebrow">{t('search.eyebrow')}</p>
    <h1>{fr ? 'Trouver un projet ou une note' : 'Find a project or a note'}</h1>
    <p class="lead">
      {
        fr
          ? 'Cherchez dans toutes les études de cas et les notes par outil, sujet ou chiffre : essayez « SQL », « Tableau » ou « clustering ».'
          : 'Search every case study and note by tool, topic or figure: try “SQL”, “Tableau” or “clustering”.'
      }
    </p>
  </section>

  <section class="section search-section" aria-label={t('search.sectionLabel')}>
    <div id="search" data-bundle-path={bundlePath}>
      <p class="search-fallback" set:html={t('search.fallback')} />
    </div>
    <script is:inline data-astro-rerun>
      // `data-astro-rerun` re-runs this after each soft navigation, because the
      // swap replaces `#search` with an empty container. `bundlePath` comes from
      // a data attribute — `define:vars` would strip `data-astro-rerun` from the
      // rendered tag. The IIFE keeps re-runs from redeclaring top-level consts;
      // the UI script itself is only loaded once and reused on later visits.
      (() => {
        const container = document.getElementById('search');
        if (!container) return;
        const bundlePath = container.dataset.bundlePath;
        const initSearch = () => {
          container.querySelector('.search-fallback')?.remove();
          new PagefindUI({
            element: '#search',
            bundlePath,
            showImages: false,
            showSubResults: true,
            autofocus: true,
          });
        };
        if (window.PagefindUI) {
          initSearch();
        } else {
          const script = document.createElement('script');
          script.src = `${bundlePath}pagefind-ui.js`;
          script.onload = initSearch;
          document.head.append(script);
        }
      })();
    </script>
  </section>
</BaseLayout>
