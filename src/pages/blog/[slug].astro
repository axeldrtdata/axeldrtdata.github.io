---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import Comments from '../../components/Comments.astro';
import { withBase } from '../../lib/url';
import { SITE } from '../../consts';
import { formatDate, readingTime, t } from '../../i18n';

export async function getStaticPaths() {
  // Newest first, same ordering as the notes list.
  const entries = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newer: entries[index - 1] ?? null,
      older: entries[index + 1] ?? null,
    },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);

// JSON-LD needs absolute URLs — resolve against `site` (astro.config.mjs).
const site = Astro.site ?? new URL(Astro.url.origin);
const absolute = (path: string) => new URL(withBase(path), site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.publishDate.toISOString(),
    url: absolute(`/blog/${entry.id}/`),
    image: absolute(`/og/blog/${entry.id}.png`),
    ...(SITE.author ? { author: { '@type': 'Person', name: SITE.author } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('post.breadcrumbHome'), item: absolute('/') },
      {
        '@type': 'ListItem',
        position: 2,
        name: t('post.breadcrumbBlog'),
        item: absolute('/blog/'),
      },
      { '@type': 'ListItem', position: 3, name: entry.data.title },
    ],
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  image={withBase(`/og/blog/${entry.id}.png`)}
>
  <StructuredData slot="head" schema={schema} />

  <div class="page-wrap">
    <a class="back-link" href={withBase('/blog/')}>← All notes</a>

    <header class="note-head bento">
      <div class="card glass note-intro">
        <span class="mono-label">{t('post.eyebrow')}</span>
        <h1 class="note-title">{entry.data.title}</h1>
        <p class="note-lead">{entry.data.description}</p>
      </div>

      <dl class="card tone-bone note-facts">
        <div>
          <dt class="mono-label">Published</dt>
          <dd>
            <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
          </dd>
        </div>
        <div>
          <dt class="mono-label">Reading time</dt>
          <dd>{readingTime(remarkPluginFrontmatter.minutesRead)}</dd>
        </div>
        {
          entry.data.tags.length > 0 && (
            <div>
              <dt class="mono-label">Tags</dt>
              <dd>
                <ul class="note-tags">
                  {entry.data.tags.map((tag) => (
                    <li>
                      <a href={withBase(`/blog/tags/${tag}/`)}>{tag}</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      entry.data.heroImage && (
        <div class="card glass note-hero">
          <Image
            src={entry.data.heroImage}
            alt=""
            widths={[720, 1040, 1400]}
            sizes="(min-width: 1200px) 1160px, 100vw"
          />
        </div>
      )
    }

    <article class="case-body" data-pagefind-body>
      <Content />
    </article>

    {
      (older || newer) && (
        <nav class="note-nav" aria-label={t('post.adjacentLabel')}>
          {older && (
            <a class="card glass note-nav-card" rel="prev" href={withBase(`/blog/${older.id}/`)}>
              <span class="mono-label">← {t('post.previous')} note</span>
              <span class="note-nav-title">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="card glass note-nav-card is-next" rel="next" href={withBase(`/blog/${newer.id}/`)}>
              <span class="mono-label">{t('post.next')} note →</span>
              <span class="note-nav-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    <Comments />
  </div>
</BaseLayout>

<style>
  .back-link {
    align-self: flex-start;
    padding: 8px 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-muted);
  }

  .note-head {
    margin-bottom: 8px;
  }

  .note-intro {
    grid-column: span 4;
    gap: 20px;
    padding: 36px;
  }

  .page-wrap .note-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .note-lead {
    max-width: 620px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .note-facts {
    grid-column: span 2;
    gap: 18px;
    margin: 0;
    padding: 30px;
  }

  .note-facts div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .note-facts dd {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
  }

  .page-wrap .note-tags a {
    display: inline-block;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--royal);
    font-size: 12px;
    font-weight: 500;
  }

  .page-wrap .note-tags a:hover {
    background: var(--powder);
  }

  .note-hero {
    padding: 22px;
  }

  .note-hero :global(img) {
    width: 100%;
    height: auto;
    border-radius: 14px;
  }

  /* ---------- Long-form content, same reading style as the case studies ---------- */
  .case-body {
    width: min(760px, 100%);
    margin: 2rem auto 0;
    font-size: 17px;
    line-height: 1.75;
    color: #2a3766;
  }

  .case-body :global(h2) {
    margin: 3.5rem 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--royal);
  }

  .case-body :global(h2:first-child) {
    margin-top: 0;
  }

  .case-body :global(h3) {
    margin: 2.25rem 0 0.75rem;
    font-size: 20px;
    font-weight: 700;
    color: var(--royal);
  }

  .case-body :global(p) {
    margin: 0 0 1.2rem;
  }

  .case-body :global(strong) {
    color: var(--royal);
  }

  .case-body :global(em) {
    font-family: var(--font-accent);
    font-size: 1.12em;
  }

  .case-body :global(ul:not([class])),
  .case-body :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.3rem;
    list-style: revert;
  }

  .case-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .case-body :global(a:not([class])) {
    color: var(--royal);
    text-decoration: underline;
    text-decoration-color: var(--steel);
    text-underline-offset: 3px;
  }

  .case-body :global(code:not(pre code)) {
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(22, 38, 96, 0.07);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .case-body :global(blockquote) {
    margin: 1.75rem 0;
    padding: 4px 0 4px 22px;
    border-left: 3px solid var(--steel);
    font-family: var(--font-accent);
    font-size: 1.3em;
    line-height: 1.4;
    color: var(--royal);
  }

  /* ---------- Previous / next ---------- */
  .note-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 3rem;
  }

  .note-nav-card {
    gap: 8px;
    padding: 26px 30px;
  }

  .note-nav-card.is-next {
    grid-column: 2;
    text-align: right;
  }

  .note-nav-title {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
  }

  @media (max-width: 860px) {
    .note-intro {
      padding: 26px;
    }

    .note-nav {
      grid-template-columns: minmax(0, 1fr);
    }

    .note-nav-card.is-next {
      grid-column: auto;
    }
  }
</style>
