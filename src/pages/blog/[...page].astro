---
// Used by /blog/ and /fr/blog/ (src/pages/fr/blog/[...page].astro).
import { render } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import NoteCard from '../../components/NoteCard.astro';
import NoteTagFilter from '../../components/NoteTagFilter.astro';
import { SITE } from '../../consts';
import { getLang, useT, readingTimeIn } from '../../i18n';
import { getPosts, type Post } from '../../lib/content';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts('en');
  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))]
    .sort((a, b) => a.localeCompare(b))
    .map((name) => ({ name, count: posts.filter((post) => post.data.tags.includes(name)).length }));
  return paginate(posts, { pageSize: 10, props: { allTags, total: posts.length } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  allTags: { name: string; count: number }[];
  total: number;
}

const { page, allTags, total } = Astro.props;
const posts = page.data;
const lang = getLang(Astro.url);
const fr = lang === 'fr';
const t = useT(lang);

const readingTimes = new Map(
  await Promise.all(
    posts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post.contentEntry);
      return [post.id, readingTimeIn(remarkPluginFrontmatter.minutesRead, lang)] as const;
    }),
  ),
);

const pageTitle =
  page.currentPage === 1 ? t('blog.title') : t('blog.titlePaged', { page: page.currentPage });
---

<BaseLayout
  title={pageTitle}
  description={
    fr
      ? `Les notes de ${SITE.title}, Data Analyst : ce que mes projets m’apprennent, la dataviz et le travail avec l’IA.`
      : `Notes by ${SITE.title}, Data Analyst: lessons from my projects, dataviz, and working with AI.`
  }
>
  <div class="page-wrap">
    <header class="notes-head">
      <span class="mono-label">{t('blog.eyebrow')}</span>
      {
        fr ? (
          <h1 class="page-title">Ce que <span class="accent">j’apprends</span> en chemin</h1>
        ) : (
          <h1 class="page-title">What I'm <span class="accent">learning</span> along the way</h1>
        )
      }
      <p class="page-lead">
        {
          fr
            ? 'De courtes notes sur ce que mes projets m’apprennent : les pièges d’analyse, les leçons de dataviz, et ma façon de travailler avec l’IA sans la laisser réfléchir à ma place.'
            : 'Short notes on what my projects teach me: analytical traps, dataviz lessons, and how I work with AI without letting it think for me.'
        }
      </p>
    </header>

    <NoteTagFilter tags={allTags} total={total} />

    <section class="bento" aria-label={t('blog.listLabel')}>
      {posts.map((post) => <NoteCard post={post} readingTime={readingTimes.get(post.id)} />)}
    </section>

    <Pagination page={page} />
  </div>
</BaseLayout>

<style>
  .notes-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 2rem 1rem;
  }
</style>
