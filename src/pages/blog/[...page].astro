---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import NoteCard from '../../components/NoteCard.astro';
import NoteTagFilter from '../../components/NoteTagFilter.astro';
import { SITE } from '../../consts';
import { readingTime, t } from '../../i18n';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))]
    .sort((a, b) => a.localeCompare(b))
    .map((name) => ({ name, count: posts.filter((post) => post.data.tags.includes(name)).length }));
  return paginate(posts, { pageSize: 10, props: { allTags, total: posts.length } });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, allTags, total } = Astro.props;
const posts = page.data;

const readingTimes = new Map(
  await Promise.all(
    posts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return [post.id, readingTime(remarkPluginFrontmatter.minutesRead)] as const;
    }),
  ),
);

const pageTitle =
  page.currentPage === 1 ? t('blog.title') : t('blog.titlePaged', { page: page.currentPage });
---

<BaseLayout
  title={pageTitle}
  description={`Notes by ${SITE.title}, Data Analyst: lessons from my projects, dataviz, and working with AI.`}
>
  <div class="page-wrap">
    <header class="notes-head">
      <span class="mono-label">{t('blog.eyebrow')}</span>
      <h1 class="page-title">What I'm <span class="accent">learning</span> along the way.</h1>
      <p class="page-lead">
        Short notes on what my projects teach me: analytical traps, dataviz lessons, and how I work
        with AI without letting it think for me.
      </p>
    </header>

    <NoteTagFilter tags={allTags} total={total} />

    <section class="bento" aria-label={t('blog.listLabel')}>
      {posts.map((post) => <NoteCard post={post} readingTime={readingTimes.get(post.id)} />)}
    </section>

    <Pagination page={page} />
  </div>
</BaseLayout>

<style>
  .notes-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 2rem 1rem;
  }
</style>
