---
// One template for both languages: /works/<slug>/ and /fr/works/<slug>/
// (src/pages/fr/works/[slug].astro passes the French entries to this page).
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { PROJECT_CATEGORIES } from '../../consts';
import { techTone } from '../../lib/tech';
import { getWorks, type Work } from '../../lib/content';
import { getLang, localePath } from '../../i18n';

export async function getStaticPaths() {
  const entries = await getWorks('en');
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(index + 1) % entries.length] },
  }));
}

interface Props {
  entry: Work;
  next: Work;
}

const { entry, next } = Astro.props;
const lang = getLang(Astro.url);
const fr = lang === 'fr';
const { Content } = await render(entry.contentEntry);
const category = PROJECT_CATEGORIES.find((item) => item.key === entry.data.category);
const year = entry.data.publishDate.getFullYear();
const L = fr
  ? {
      back: '← Tous les projets',
      kind: 'Étude de cas',
      report: 'Voir le rapport sur GitHub ↗',
      code: 'Voir le code sur GitHub ↗',
      notebook: 'Voir le notebook sur GitHub ↗',
      dashboard: 'Ouvrir le dashboard en ligne ↗',
      live: 'Ouvrir la version en ligne ↗',
      client: 'Client',
      role: 'Rôle',
      year: 'Année',
      stack: 'Outils',
      next: 'Étude de cas suivante',
      notTranslated: 'Cette étude de cas n’est pas encore traduite : elle s’affiche en anglais.',
    }
  : {
      back: '← All projects',
      kind: 'Case study',
      report: 'View the report on GitHub ↗',
      code: 'View the code on GitHub ↗',
      notebook: 'View the notebook on GitHub ↗',
      dashboard: 'Open the live dashboard ↗',
      live: 'Open the live version ↗',
      client: 'Client',
      role: 'Role',
      year: 'Year',
      stack: 'Stack',
      next: 'Next case study',
      notTranslated: '',
    };
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  image={withBase(`/og/${fr ? 'fr-works' : 'works'}/${entry.id}.png`)}
>
  <div class="page-wrap">
    <a class="back-link" href={localePath('/works/', lang)}>{L.back}</a>

    <header class="case-head bento">
      <div class="card glass case-intro">
        <div class="case-top">
          <span class="mono-label">
            {L.kind}{category && ` · ${category.label}`}
          </span>
          {
            entry.data.icon && (
              <Image class="case-icon" src={entry.data.icon} alt="" width={256} height={256} />
            )
          }
        </div>
        <h1 class="case-title">{entry.data.title}</h1>
        <p class="case-lead">{entry.data.description}</p>
        <div class="case-actions">
          {
            entry.data.repo && (
              <a class="btn btn-royal" href={entry.data.repo} target="_blank" rel="noopener noreferrer">
                {entry.data.tech.includes('Power BI') ? L.report : entry.data.category === 'sql' ? L.code : L.notebook}
              </a>
            )
          }
          {
            entry.data.link && (
              <a class="btn btn-outline" href={entry.data.link} target="_blank" rel="noopener noreferrer">
                {entry.data.category === 'dataviz' ? L.dashboard : L.live}
              </a>
            )
          }
        </div>
      </div>

      <dl class="card tone-bone case-facts">
        {
          entry.data.client && (
            <div>
              <dt class="mono-label">{L.client}</dt>
              <dd>{entry.data.client}</dd>
            </div>
          )
        }
        {
          entry.data.role && (
            <div>
              <dt class="mono-label">{L.role}</dt>
              <dd>{entry.data.role}</dd>
            </div>
          )
        }
        <div>
          <dt class="mono-label">{L.year}</dt>
          <dd>{year}</dd>
        </div>
        <div>
          <dt class="mono-label">{L.stack}</dt>
          <dd>
            <ul class="tag-row">{entry.data.tech.map((tech) => <li class={techTone(tech)}>{tech}</li>)}</ul>
          </dd>
        </div>
      </dl>
    </header>

    <article class="case-body" data-pagefind-body lang={fr && !entry.translated ? 'en' : undefined}>
      {fr && !entry.translated && <p class="not-translated">{L.notTranslated}</p>}
      <Content />
    </article>

    {
      next.id !== entry.id && (
        <a class="card glass next-case" href={localePath(`/works/${next.id}/`, lang)}>
          <span class="mono-label">{L.next}</span>
          <span class="next-title">{next.data.title} →</span>
        </a>
      )
    }
  </div>
</BaseLayout>

<style>
  .not-translated {
    margin: 0 0 2rem;
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--powder);
    font-size: 15px;
  }

  .back-link {
    align-self: flex-start;
    padding: 8px 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-muted);
  }

  .case-head {
    margin-bottom: 8px;
  }

  .case-intro {
    grid-column: span 4;
    gap: 20px;
    padding: 36px;
  }

  .case-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .case-icon {
    width: 128px;
    height: 128px;
    flex-shrink: 0;
    margin: -14px -12px -12px 0;
    object-fit: contain;
  }

  @media (max-width: 560px) {
    .case-icon {
      width: 84px;
      height: 84px;
      margin: -6px -4px -6px 0;
    }
  }

  .case-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .case-lead {
    max-width: 620px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .case-facts {
    grid-column: span 2;
    gap: 18px;
    margin: 0;
    padding: 30px;
  }

  .case-facts div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .case-facts dd {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* ---------- Long-form content ---------- */
  .case-body {
    width: min(760px, 100%);
    margin: 2rem auto 0;
    font-size: 17px;
    line-height: 1.75;
    color: #2a3766;
  }

  .case-body :global(h2) {
    margin: 3.5rem 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--royal);
  }

  .case-body :global(h2:first-child) {
    margin-top: 0;
  }

  .case-body :global(h3) {
    margin: 2.25rem 0 0.75rem;
    font-size: 20px;
    font-weight: 700;
    color: var(--royal);
  }

  .case-body :global(p) {
    margin: 0 0 1.2rem;
  }

@media (min-width: 700px) {
    .case-body :global(p) {
      text-align: justify;
      hyphens: auto;
    }
  }

  .case-body :global(strong) {
    color: var(--royal);
  }

  .case-body :global(em) {
    font-family: var(--font-accent);
    font-size: 1.12em;
  }

  .case-body :global(ul:not([class])),
  .case-body :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.3rem;
    list-style: revert;
  }

  .case-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .case-body :global(a:not([class])) {
    color: var(--royal);
    text-decoration: underline;
    text-decoration-color: var(--steel);
    text-underline-offset: 3px;
  }

  .case-body :global(code:not(pre code)) {
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(22, 38, 96, 0.07);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .case-body :global(pre) {
    margin: 1.75rem 0;
    padding: 22px 24px;
    overflow-x: auto;
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.75);
    box-shadow: var(--shadow-card);
    font-size: 14px;
    line-height: 1.65;
    white-space: pre !important;
  }

  .case-body :global(table) {
    width: 100%;
    margin: 1.75rem 0;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    background: var(--glass-bg);
    box-shadow: var(--shadow-card);
    font-size: 15px;
  }

  .case-body :global(th) {
    padding: 14px 18px;
    background: rgba(22, 38, 96, 0.06);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  .case-body :global(td) {
    padding: 13px 18px;
    border-top: 1px solid var(--color-line);
    vertical-align: top;
  }

  .next-case {
    margin-top: 3rem;
    gap: 8px;
    padding: 28px 32px;
  }

  .next-title {
    font-size: 22px;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .case-intro {
      padding: 26px;
    }

    .case-body :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
