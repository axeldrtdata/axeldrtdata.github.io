---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE, PROJECT_CATEGORIES } from '../../consts';

const works = (await getCollection('works')).sort((a, b) => {
  const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
  if (orderA !== orderB) return orderA - orderB;
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Only show a filter when at least one project uses that category.
const filters = PROJECT_CATEGORIES.map((category) => ({
  ...category,
  count: works.filter((work) => work.data.category === category.key).length,
})).filter((category) => category.count > 0);
---

<BaseLayout title="Projects" description={`Data analysis projects and case studies by ${SITE.title}.`}>
  <div class="page-wrap">
    <header class="works-head">
      <span class="mono-label">Projects</span>
      <h1 class="page-title">Every analysis, <span class="accent">start to finish</span>.</h1>
      <p class="page-lead">
        {works.length} projects across Python, SQL and data visualisation. Each one starts from a business
        question and ends with something a team can act on.
      </p>
    </header>

    {
      filters.length > 0 && (
        <div class="filters" role="group" aria-label="Filter projects">
          <button class="filter" type="button" data-filter="all" aria-pressed="true">
            All <span>{works.length}</span>
          </button>
          {filters.map((category) => (
            <button class="filter" type="button" data-filter={category.key} aria-pressed="false">
              {category.label} <span>{category.count}</span>
            </button>
          ))}
        </div>
      )
    }

    <section class="bento" aria-label="All projects">
      {works.map((work, index) => <ProjectCard work={work} number={index + 1} />)}
    </section>
  </div>
</BaseLayout>

<script>
  // Client-side filtering. Re-runs after each page navigation (view transitions).
  function initProjectFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-category]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        cards.forEach((card) => {
          card.hidden = filter !== 'all' && card.dataset.category !== filter;
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>

<style>
  .works-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 2rem 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    color: var(--royal);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .filter span {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: rgba(22, 38, 96, 0.08);
    font-size: 12px;
  }

  .filter:hover {
    background: #fff;
  }

  .filter[aria-pressed='true'] {
    background: var(--royal);
    border-color: var(--royal);
    color: #fff;
  }

  .filter[aria-pressed='true'] span {
    background: rgba(255, 255, 255, 0.18);
  }
</style>