---
// Used by /works/ and /fr/works/ (src/pages/fr/works/index.astro).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE, PROJECT_CATEGORIES } from '../../consts';
import { getWorks } from '../../lib/content';
import { getLang } from '../../i18n';

const lang = getLang(Astro.url);
const fr = lang === 'fr';
const works = await getWorks(lang);

// Only show a filter when at least one project uses that category.
const filters = PROJECT_CATEGORIES.map((category) => ({
  ...category,
  count: works.filter((work) => work.data.category === category.key).length,
})).filter((category) => category.count > 0);
---

<BaseLayout
  title={fr ? 'Projets' : 'Projects'}
  description={fr ? `Projets et études de cas en analyse de données, par ${SITE.title}.` : `Data analysis projects and case studies by ${SITE.title}.`}
>
  <div class="page-wrap">
    <header class="works-head">
      <span class="mono-label">{fr ? 'Projets' : 'Projects'}</span>
      {
        fr ? (
          <h1 class="page-title">Chaque analyse, <span class="accent">de bout en bout</span></h1>
        ) : (
          <h1 class="page-title">Every analysis, <span class="accent">start to finish</span></h1>
        )
      }
      <p class="page-lead">
        {
          fr
            ? `${works.length} projets en Python, SQL et data visualisation. Chacun part d’une question métier et se termine par une réponse sur laquelle une équipe peut agir.`
            : `${works.length} projects across Python, SQL and data visualisation. Each one starts from a business question and ends with something a team can act on.`
        }
      </p>
    </header>

    {
      filters.length > 0 && (
        <div class="filters" role="group" aria-label={fr ? 'Filtrer les projets' : 'Filter projects'}>
          <button class="filter" type="button" data-filter="all" aria-pressed="true">
            {fr ? 'Tous' : 'All'} <span>{works.length}</span>
          </button>
          {filters.map((category) => (
            <button class="filter" type="button" data-filter={category.key} aria-pressed="false">
              {category.label} <span>{category.count}</span>
            </button>
          ))}
        </div>
      )
    }

    <section class="bento" aria-label={fr ? 'Tous les projets' : 'All projects'}>
      {works.map((work, index) => <ProjectCard work={work} number={index + 1} />)}
    </section>
  </div>
</BaseLayout>

<script>
  // Client-side filtering. Re-runs after each page navigation (view transitions).
  function initProjectFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-category]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        cards.forEach((card) => {
          card.hidden = filter !== 'all' && card.dataset.category !== filter;
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>

<style>
  .works-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 2rem 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    color: var(--royal);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .filter span {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: rgba(22, 38, 96, 0.08);
    font-size: 12px;
  }

  .filter:hover {
    background: #fff;
  }

  .filter[aria-pressed='true'] {
    background: var(--royal);
    border-color: var(--royal);
    color: #fff;
  }

  .filter[aria-pressed='true'] span {
    background: rgba(255, 255, 255, 0.18);
  }
</style>