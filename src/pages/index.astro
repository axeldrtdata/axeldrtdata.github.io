---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EmailCopyButton from '../components/EmailCopyButton.astro';
import { withBase } from '../lib/url';
import { SITE, SITE_FR, HOME, PROJECT_CATEGORIES } from '../consts';
import { getLang, localePath, formatDateIn } from '../i18n';
import { getWorks, getPosts } from '../lib/content';

// Used by / and /fr/ (src/pages/fr/index.astro): every text below comes from `c`.
const lang = getLang(Astro.url);
const fr = lang === 'fr';
const cv = fr && HOME.cvFr ? HOME.cvFr : HOME.cv;

const COPY = {
  en: {
    intro: 'Introduction',
    status: HOME.status,
    portrait: 'Portrait of Axel Derobert',
    titleA: 'Curious by nature',
    titleB: 'analytical by training',
    lead: 'Before I trust a number, I look at what it hides, and that is usually where the real answer is. Python, SQL, Power BI and Tableau are how I find it.',
    viewProjects: 'View my projects',
    talk: "Let's talk",
    cv: 'Download my CV',
    basedIn: 'Based in',
    hybrid: 'Open to hybrid work',
    calledHome: 'Called home',
    countries: '4 countries',
    journey: ['France, where it started', 'Australia', 'Sweden', 'The Netherlands', 'Back in Lyon, today'],
    fluent: 'Fluent in French and English',
    mixCaption: 'projects, from exploratory analysis to dashboards',
    mixLabel: 'Project mix',
    education: 'Education',
    rncp: "RNCP Level 6, Bachelor's equivalent",
    since: 'October 2025 – ongoing',
    toolkitA: 'My',
    toolkitB: 'toolkit',
    quote: 'Finding the story behind the numbers',
    teaser: 'France, Australia, Sweden, the Netherlands: four countries taught me to figure out how things work wherever I land. Data is where that curiosity found its playground.',
    story: 'Read my story',
    featuredEyebrow: '01 — Featured projects',
    featuredA: 'Analyses that answer real ',
    featuredB: 'business questions',
    allProjects: 'All projects',
    featuredLabel: 'Featured projects',
    notesEyebrow: '02 — Notes',
    notesA: "What's ",
    notesB: 'caught my curiosity',
    notesC: ' lately',
    allNotes: 'All notes',
    notesLabel: 'Latest notes',
    readNote: 'Read the note →',
    contactA: 'Got a question your data ',
    contactB: "hasn't answered yet?",
    contactFallback: 'Lyon, France · open to hybrid',
    linkedin: "Let's talk on LinkedIn",
  },
  fr: {
    intro: 'Présentation',
    status: SITE_FR.status,
    portrait: 'Portrait d’Axel Derobert',
    titleA: 'Curieux de nature',
    titleB: 'analyste par formation',
    lead: 'Avant de faire confiance à un chiffre, je regarde ce qu’il cache : c’est souvent là que se trouve la vraie réponse. Python, SQL, Power BI et Tableau sont mes outils pour la trouver.',
    viewProjects: 'Voir mes projets',
    talk: 'Discutons',
    cv: 'Télécharger mon CV',
    basedIn: 'Basé à',
    hybrid: 'Ouvert au travail hybride',
    calledHome: 'Là où j’ai vécu',
    countries: '4 pays',
    journey: ['La France, là où tout a commencé', 'Australie', 'Suède', 'Pays-Bas', 'De retour à Lyon, aujourd’hui'],
    fluent: 'Bilingue français et anglais',
    mixCaption: 'projets, de l’analyse exploratoire aux dashboards',
    mixLabel: 'Répartition des projets',
    education: 'Formation',
    rncp: 'Titre RNCP niveau 6, équivalent Bac+3',
    since: 'Depuis octobre 2025',
    toolkitA: 'Ma',
    toolkitB: 'boîte à outils',
    quote: 'Trouver l’histoire derrière les chiffres',
    teaser: 'France, Australie, Suède, Pays-Bas : quatre pays m’ont appris à comprendre comment les choses fonctionnent, où que j’arrive. La data est devenue le terrain de jeu de cette curiosité.',
    story: 'Lire mon parcours',
    featuredEyebrow: '01 — Projets à la une',
    featuredA: 'Des analyses qui répondent à de vraies ',
    featuredB: 'questions métier',
    allProjects: 'Tous les projets',
    featuredLabel: 'Projets à la une',
    notesEyebrow: '02 — Notes',
    notesA: 'Ce qui a ',
    notesB: 'piqué ma curiosité',
    notesC: ' ces derniers temps',
    allNotes: 'Toutes les notes',
    notesLabel: 'Dernières notes',
    readNote: 'Lire la note →',
    contactA: 'Une question à laquelle vos données ',
    contactB: 'n’ont pas encore répondu ?',
    contactFallback: 'Lyon, France · ouvert à l’hybride',
    linkedin: 'Discutons sur LinkedIn',
  },
};
const c = COPY[lang];

// Projects: featured ones first (max 3), otherwise the first three by order.
const allWorks = await getWorks(lang);
const featuredWorks = allWorks.filter((work) => work.data.featured);
const showcase = (featuredWorks.length > 0 ? featuredWorks : allWorks).slice(0, 3);

// Project mix chart, computed from the real collection.
const mix = PROJECT_CATEGORIES.map((category) => ({
  ...category,
  count: allWorks.filter((work) => work.data.category === category.key).length,
}));
const mixLabel = mix.map((item) => `${item.count} ${item.label}`).join(', ');

const posts = (await getPosts(lang)).slice(0, 2);

const heroTone = HOME.style === 'dark' ? 'is-dark' : 'is-light';
const quoteTone = HOME.style === 'dark' ? 'is-light' : 'is-dark';

const journey = [
  { code: 'FR', label: c.journey[0] },
  { code: 'AU', label: c.journey[1] },
  { code: 'SE', label: c.journey[2] },
  { code: 'NL', label: c.journey[3] },
  { code: 'FR', label: c.journey[4], now: true },
];

const toolkit = [
  { name: 'Python', tone: 'pill-dark' },
  { name: 'SQL', tone: 'pill-dark' },
  { name: 'Pandas', tone: 'pill-powder' },
  { name: 'scikit-learn', tone: 'pill-powder' },
  { name: 'Matplotlib', tone: 'pill-powder' },
  { name: 'Seaborn', tone: 'pill-powder' },
  { name: 'Power BI', tone: 'pill-bone' },
  { name: 'Tableau', tone: 'pill-bone' },
  { name: 'dbt', tone: 'pill-bone' },
  { name: 'Snowflake', tone: 'pill-bone' },
  { name: 'SQLite', tone: 'pill-bone' },
  { name: 'VS Code', tone: 'pill-bone' },
  { name: 'Excel', tone: 'pill-bone' },
  { name: 'Git', tone: 'pill-bone' },
];

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: fr ? SITE_FR.description : SITE.description,
  url: new URL(localePath('/', lang), site).href,
  inLanguage: lang,
};
---

<BaseLayout description={fr ? SITE_FR.description : SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <div class="page-wrap">
    <section class="bento" aria-label={c.intro}>
      <div class:list={['card', 'intro', heroTone]}>
        <div class="intro-glow" aria-hidden="true"></div>
        <div class="intro-body">
          <div class="intro-top">
            <div class="identity-text">
              <span class="identity-name">Axel Derobert</span>
              <span class="identity-role">DATA ANALYST · LYON</span>
              <span class="status"><span class="status-dot"></span>{c.status}</span>
            </div>
            {
              HOME.photo ? (
                <img class="photo" src={withBase(HOME.photo)} alt={c.portrait} width="336" height="384" />
              ) : (
                <div class="photo photo-placeholder">Photo</div>
              )
            }
          </div>

          <h1 class="intro-title">
            {c.titleA}
            <span class="intro-highlight accent"
              >{c.titleB}<svg
                aria-hidden="true"
                viewBox="0 0 300 16"
                preserveAspectRatio="none"
                ><path d="M3 11 C 70 3, 150 2, 297 8"></path></svg
              ></span
            >
          </h1>
          <p class="intro-lead">{c.lead}</p>
        </div>

        <div class="intro-actions">
          <a class="btn btn-primary" href={localePath('/works/', lang)}>
            {c.viewProjects}
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn-secondary" href={HOME.linkedin} target="_blank" rel="noopener noreferrer">
            <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"></rect><path d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 0 0-4 0"></path></svg>
            {c.talk}
          </a>
          {cv && <a class="btn btn-ghost" href={withBase(cv)} download>{c.cv}</a>}
        </div>
      </div>

      <div class="card glass geo">
        <div class="card-head">
          <span class="mono-label">{c.basedIn}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
        </div>
        <div class="geo-city">
          <span class="geo-name">Lyon<span class="accent-italic">, France</span></span>
          <span class="mono-small">45.76° N · 4.84° E</span>
          <span class="muted-small">{c.hybrid}</span>
        </div>
        <div class="divider"></div>
        <div class="journey">
          <div class="journey-head">
            <span class="mono-label">{c.calledHome}</span>
            <span class="accent-italic journey-count">{c.countries}</span>
          </div>
          <ol class="journey-list">
            {
              journey.map((stop) => (
                <li class:list={[{ now: stop.now }]}>
                  <span class="journey-dot" />
                  <span class="journey-code">{stop.code}</span>
                  <span class="journey-label">{stop.label}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <span class="muted-small">{c.fluent}</span>
      </div>

      <div class="card glass mix">
        <div class="mix-head">
          <div class="mix-total">
            <span class="mix-number">{allWorks.length}</span>
            <span class="mix-caption">{c.mixCaption}</span>
          </div>
          <span class="mono-small">portfolio.describe()</span>
        </div>
        <div class="mix-bar" role="img" aria-label={`${c.mixLabel}: ${mixLabel}`}>
          {
            mix
              .filter((item) => item.count > 0)
              .map((item) => <div style={`flex: ${item.count}; background: ${item.color}`} />)
          }
        </div>
        <ul class="mix-legend">
          {
            mix.filter((item) => item.count > 0).map((item) => (
              <li>
                <span class="legend-swatch" style={`background: ${item.color}`} />
                {item.label} · {item.count}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card tone-bone education">
        <div class="card-head">
          <span class="mono-label">{c.education}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5z"></path><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"></path></svg>
        </div>
        <div class="education-body">
          <span class="education-title">Data Analyst, <span class="accent">OpenClassrooms</span></span>
          <span class="muted-small">{c.rncp}</span>
          <span class="muted-small">{c.since}</span>
        </div>
      </div>

      <div class="card glass toolkit">
        <div class="card-head">
          <h2 class="toolkit-title">{c.toolkitA} <span class="accent">{c.toolkitB}</span></h2>
          <span class="mono-small toolkit-import">import *</span>
        </div>
        <ul class="pill-list">
          {toolkit.map((tool) => <li class:list={['pill', tool.tone]}>{tool.name}</li>)}
        </ul>
      </div>

      <div class:list={['card', 'quote', quoteTone]}>
        <span class="quote-mark" aria-hidden="true">“</span>
        <div class="quote-body">
          <p class="quote-text">{c.quote}</p>
          <p class="quote-teaser">{c.teaser}</p>
        </div>
        <a class="quote-link" href={localePath('/about/', lang)}>
          {c.story}
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </section>

    <div class="section-head" id="projects">
      <div>
        <span class="mono-label">{c.featuredEyebrow}</span>
        <h2>{c.featuredA}<span class="accent">{c.featuredB}</span></h2>
      </div>
      <a class="btn btn-outline" href={localePath('/works/', lang)}>{c.allProjects} ({allWorks.length})</a>
    </div>

    <section class="bento" aria-label={c.featuredLabel}>
      {showcase.map((work, index) => <ProjectCard work={work} number={index + 1} />)}
    </section>

    {
      posts.length > 0 && (
        <>
    <div class="section-head" id="notes">
      <div>
        <span class="mono-label">{c.notesEyebrow}</span>
        <h2>{c.notesA}<span class="accent">{c.notesB}</span>{c.notesC}</h2>
      </div>
      <a class="btn btn-outline" href={localePath('/blog/', lang)}>{c.allNotes}</a>
    </div>

    <section class="bento" aria-label={c.notesLabel}>
      {
        posts.map((post) => (
          <article class="card glass note">
            <div class="note-meta">
              {formatDateIn(post.data.publishDate, lang, 'short')}
              {post.data.tags[0] && ` · ${post.data.tags[0]}`}
            </div>
            <h3>
              <a href={localePath(`/blog/${post.id}/`, lang)}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
            <a class="note-link" href={localePath(`/blog/${post.id}/`, lang)}>
              {c.readNote}
            </a>
          </article>
        ))
      }
    </section>
        </>
      )
    }

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <span class="mono-label">{posts.length > 0 ? '03' : '02'} — Contact</span>
      <h2 id="contact-title">
        {c.contactA}<span class="accent">{c.contactB}</span>
      </h2>
      <div class="contact-row">
        <span class="mono-small">{HOME.email || c.contactFallback}</span>
        <div class="contact-actions">
          <a class="btn btn-powder" href={HOME.linkedin} target="_blank" rel="noopener noreferrer">
            {c.linkedin}
          </a>
          {
            cv && (
              <a class="btn btn-white" href={withBase(cv)} download>
                {c.cv}
              </a>
            )
          }
          {HOME.email && <EmailCopyButton email={HOME.email} />}
          <a class="btn btn-ghost-light" href={HOME.github} target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Homepage-only styles. Shared pieces (cards, glass, buttons…) live in src/styles/bento.css. */

  /* ---------- Intro card (two variants, see HOME.style) ---------- */
  .intro {
    grid-column: span 4;
    grid-row: span 2;
    position: relative;
    overflow: hidden;
    justify-content: space-between;
    gap: 36px;
    padding: 40px;
    color: var(--hero-text);
  }

  .intro.is-dark {
    --hero-text: #fff;
    --hero-muted: rgba(255, 255, 255, 0.82);
    --hero-sub: rgba(255, 255, 255, 0.75);
    --hero-highlight: var(--bone);
    --hero-underline: var(--bone);
    --badge-bg: rgba(255, 255, 255, 0.12);
    --badge-border: rgba(255, 255, 255, 0.22);
    --dot: #5bd69a;
    --btn1-bg: #fff;
    --btn1-fg: var(--royal);
    --btn2-bg: var(--powder);
    --btn3-border: rgba(255, 255, 255, 0.45);
    --btn3-fg: #fff;
    --glow: rgba(208, 230, 253, 0.22);
    background: var(--royal);
    box-shadow: 0 18px 50px rgba(22, 38, 96, 0.28);
  }

  .intro.is-light {
    --hero-text: var(--royal);
    --hero-muted: #2a3766;
    --hero-sub: #2a3766;
    --hero-highlight: var(--royal);
    --hero-underline: var(--steel);
    --badge-bg: rgba(255, 255, 255, 0.65);
    --badge-border: #fff;
    --dot: #1e7a4c;
    --btn1-bg: var(--royal);
    --btn1-fg: #fff;
    --btn2-bg: #fff;
    --btn3-border: rgba(22, 38, 96, 0.3);
    --btn3-fg: var(--royal);
    --glow: rgba(255, 255, 255, 0.55);
    background: var(--powder);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 12px 40px rgba(22, 38, 96, 0.1);
  }

  .intro-glow {
    position: absolute;
    right: -120px;
    bottom: -160px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow) 0%, transparent 70%);
    pointer-events: none;
  }

  .intro-body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .intro-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .photo {
    width: 176px;
    height: 198px;
    flex-shrink: 0;
    margin: -22px -22px -48px 0;
    border-radius: 24px;
    border: 3px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    object-fit: cover;
    object-position: center 30%;
  }

  @media (max-width: 560px) {
    .photo {
      width: 96px;
      height: 112px;
      margin: 0;
      border-radius: 18px;
    }
  }

  .photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bone);
    color: #2a3766;
    font-family: var(--font-mono);
    font-size: 12px;
    text-align: center;
  }

  .identity-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding-top: 6px;
  }

  .identity-text .status {
    margin-top: 16px;
    padding: 10px 18px;
    font-size: clamp(13px, 1.3vw, 16px);
  }

  .identity-name {
    font-size: clamp(22px, 2.9vw, 36px);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .identity-role {
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.3vw, 16px);
    letter-spacing: 0.06em;
    color: var(--hero-sub);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    font-size: 13px;
    font-weight: 600;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--dot), transparent 80%);
  }

  .intro-title {
    max-width: 760px;
    font-size: clamp(2.5rem, 5vw, 3.6rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .intro-highlight {
    position: relative;
    display: inline-block;
    font-size: 1.14em;
    color: var(--hero-highlight);
  }

  /* Staircase indent on the second line, only where there is room for it */
  @media (min-width: 1180px) {
    .intro-title {
      margin-left: -0.06em;
    }

    .intro-highlight {
      margin-left: 2.2em;
      white-space: nowrap;
    }
  }

  @media (min-width: 861px) and (max-width: 1179px) {
    .intro-title {
      margin-left: -0.06em;
    }

    .intro-highlight {
      margin-left: 0.9em;
      white-space: nowrap;
    }
  }

  .intro-highlight svg {
    position: absolute;
    left: 2%;
    bottom: -6px;
    width: 96%;
    height: 12px;
    overflow: visible;
    stroke: var(--hero-underline);
    stroke-width: 3;
    opacity: 0.7;
  }

  .intro-lead {
    max-width: none;
    font-size: 18px;
    line-height: 1.6;
    color: var(--hero-muted);
  }

  .intro-actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn-primary,
  .btn-primary:hover {
    background: var(--btn1-bg);
    color: var(--btn1-fg);
  }

  .btn-secondary,
  .btn-secondary:hover {
    background: var(--btn2-bg);
    color: var(--royal);
  }

  .btn-ghost,
  .btn-ghost:hover {
    border-color: var(--btn3-border);
    color: var(--btn3-fg);
  }

  /* ---------- Geography card ---------- */
  .geo {
    grid-column: span 2;
    grid-row: span 2;
    justify-content: space-between;
    gap: 22px;
  }

  .geo-city {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .geo-name {
    font-family: var(--font-accent);
    font-size: 44px;
    line-height: 1;
  }

  .journey {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .journey-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .journey-count {
    font-size: 20px;
  }

  .journey-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .journey-list li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    font-weight: 500;
  }

  .journey-list li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 18px;
    bottom: -14px;
    width: 2px;
    background: rgba(22, 38, 96, 0.18);
  }

  .journey-dot {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--royal);
  }

  .journey-list li.now {
    font-weight: 700;
  }

  .journey-list li.now .journey-dot {
    background: var(--royal);
    box-shadow: 0 0 0 4px rgba(22, 38, 96, 0.15);
  }

  .journey-code {
    width: 26px;
    font-family: var(--font-mono);
