---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailCopyButton from '../../components/EmailCopyButton.astro';
import { withBase } from '../../lib/url';
import { HOME } from '../../consts';

const projectCount = (await getCollection('works')).length;

const journey = [
  { code: 'FR', label: 'France, where I grew up' },
  { code: 'AU', label: 'Australia' },
  { code: 'SE', label: 'Sweden' },
  { code: 'NL', label: 'The Netherlands' },
  { code: 'FR', label: 'Back in Lyon, today', now: true },
];

// One field per case study, in the same order as the Projects page; each tag links to its case study.
const fields = [
  { label: 'Fraud detection', slug: 'counterfeit-banknotes' },
  { label: 'Rental investment', slug: 'airbnb-investment-dashboard' },
  { label: 'Market research', slug: 'poultry-export-markets' },
  { label: 'Education', slug: 'student-demographics-dbt' },
  { label: 'Project management', slug: 'sanitoral-powerbi-dashboard' },
  { label: 'E-commerce', slug: 'online-bookshop-sales' },
  { label: 'Retail', slug: 'bottleneck-stock-sales' },
  { label: 'Real estate', slug: 'french-property-market-sql' },
  { label: 'Food security', slug: 'global-food-security' },
  { label: 'Insurance', slug: 'home-insurance-sql' },
];
---

<BaseLayout title="About" description="Axel Derobert, Data Analyst in Lyon: finding the story behind the numbers.">
  <div class="page-wrap">
    <section class="bento" aria-label="About Axel">
      <div class="card glass about-intro">
        <span class="mono-label">About</span>
        <h1 class="page-title">Finding the <span class="accent">story</span> behind the numbers</h1>
        <p class="page-lead">
          Born and raised in France, I left right after high school to live abroad: Australia, then
          Sweden, then the Netherlands. Those years away made me fluent in English, taught me real
          independence, and left me with a lasting curiosity: figuring out how things work wherever I land.
        </p>
      </div>

      <div class="card portrait-card">
        {
          HOME.photo ? (
            <img class="portrait" src={withBase(HOME.photo)} alt="Portrait of Axel Derobert" width="480" height="480" />
          ) : (
            <div class="portrait portrait-placeholder">[Your photo]</div>
          )
        }
      </div>

      <div class="card tone-powder today">
        <span class="mono-label">Today</span>
        <p class="today-text">
          That curiosity has found its playground: <strong>data</strong>. I am training as a Data
          Analyst with OpenClassrooms, learning to turn raw, messy data into clear decisions a team can
          act on.
        </p>
      </div>

      <div class="card tone-bone toolkit-card">
        <span class="mono-label">My toolkit</span>
        <p class="toolkit-text">
          Python, SQL, Power BI, Tableau: <span class="accent">whatever it takes to make data talk.</span>
        </p>
      </div>

      <div class="card glass fields">
        <div class="card-head">
          <span class="mono-label">End-to-end analyses</span>
          <span class="mono-small">{projectCount} on this site</span>
        </div>
        <p class="fields-text">
          Across my OpenClassrooms projects, I have run analyses from raw data to recommendation in
          very different fields.
        </p>
        <ul class="tag-row big-tags">
          {
            fields.map((field) => (
              <li>
                <a href={withBase(`/works/${field.slug}/`)}>{field.label}</a>
              </li>
            ))
          }
        </ul>
        <a class="fields-link" href={withBase('/works/')}>See the case studies →</a>
      </div>

      <div class="card glass journey-card">
        <div class="card-head">
          <span class="mono-label">Called home</span>
          <span class="accent-italic journey-count">4 countries</span>
        </div>
        <ol class="journey-list">
          {
            journey.map((stop) => (
              <li class:list={[{ now: stop.now }]}>
                <span class="journey-dot" />
                <span class="journey-code">{stop.code}</span>
                <span>{stop.label}</span>
              </li>
            ))
          }
        </ol>
        <span class="muted-small">Native French, fluent English</span>
      </div>

      <div class="card tone-bone method">
        <span class="mono-label">How I work</span>
        <p class="method-title">Curious first, rigorous always</p>
        <p class="method-text">
          I start with questions: what is the data really saying, and what might it be leaving out?
          Then I check before I conclude. I recompute the key figures from the source and look at
          units, joins and missing values. Coming back to my projects for this portfolio, that habit
          sharpened several of my conclusions, and each case study shows how.
        </p>
        <ol class="method-steps">
          <li>
            <span class="method-step-num">01</span>
            <span class="method-step-title">Question</span>
            <span class="method-step-text">What does the business really need to know?</span>
          </li>
          <li>
            <span class="method-step-num">02</span>
            <span class="method-step-title">Clean</span>
            <span class="method-step-text">Units, joins and gaps, fixed before any chart.</span>
          </li>
          <li>
            <span class="method-step-num">03</span>
            <span class="method-step-title">Explore</span>
            <span class="method-step-text">Patterns and outliers, tested, not assumed.</span>
          </li>
          <li>
            <span class="method-step-num">04</span>
            <span class="method-step-title">Story</span>
            <span class="method-step-text">One clear answer a team can act on.</span>
          </li>
        </ol>
      </div>

      <div class="card glass offscreen">
        <span class="mono-label">Off-screen</span>
        <ul class="offscreen-list">
          <li>
            <span class="offscreen-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
            </span>
            <span>
              <span class="offscreen-title">Music</span>
              <span class="offscreen-text">Listening to it, and making it.</span>
            </span>
          </li>
          <li>
            <span class="offscreen-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7l4.5 3.3-1.7 5.2H9.2L7.5 10.3z"></path></svg>
            </span>
            <span>
              <span class="offscreen-title">Football</span>
              <span class="offscreen-text">Watching the game, and reading the numbers behind it.</span>
            </span>
          </li>
          <li>
            <span class="offscreen-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18"></path><path d="M12 3a14 14 0 0 0 0 18"></path></svg>
            </span>
            <span>
              <span class="offscreen-title">Travel</span>
              <span class="offscreen-text">Discovering new places, a habit four countries left me with.</span>
            </span>
          </li>
        </ul>
      </div>

      <a class="card glass notes-card" href={withBase('/blog/')}>
        <span class="mono-label">Notes</span>
        <p class="notes-text">What my projects taught me, from analytical traps to working with AI</p>
        <span class="notes-link">Read the notes →</span>
      </a>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <span class="mono-label">What I'm looking for</span>
      <h2 id="cta-title">
        A data internship in Lyon or hybrid. If you need someone <span class="accent">curious and rigorous</span>,
        let's talk.
      </h2>
      <div class="cta-actions">
        <a class="btn btn-powder" href={HOME.linkedin} target="_blank" rel="noopener noreferrer">Let's talk on LinkedIn</a>
        {HOME.cv && <a class="btn btn-white" href={withBase(HOME.cv)} download>Download my CV</a>}
        {HOME.email && <EmailCopyButton email={HOME.email} />}
        <a class="btn btn-ghost-light" href={HOME.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-intro {
    grid-column: span 4;
    justify-content: center;
    gap: 20px;
    padding: 40px;
  }

  .portrait-card {
    grid-column: span 2;
    padding: 0;
    overflow: hidden;
    background: var(--powder);
  }

  .portrait {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
  }

  .portrait-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .today {
    grid-column: span 4;
    justify-content: center;
  }

  .today-text {
    font-family: var(--font-accent);
    font-size: 26px;
    line-height: 1.35;
  }

  .today-text strong {
    font-family: var(--font-body);
    font-size: 0.9em;
  }

  .journey-card {
    grid-column: span 2;
    gap: 22px;
  }

  .journey-card .muted-small {
    margin-top: auto;
  }

  .journey-count {
    font-size: 20px;
  }

  .journey-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .journey-list li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    font-weight: 500;
  }

  .journey-list li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 18px;
    bottom: -14px;
    width: 2px;
    background: rgba(22, 38, 96, 0.18);
  }

  .journey-dot {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--royal);
  }

  .journey-list li.now {
    font-weight: 700;
  }

  .journey-list li.now .journey-dot {
    background: var(--royal);
    box-shadow: 0 0 0 4px rgba(22, 38, 96, 0.15);
  }

  .journey-code {
    width: 26px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  .fields {
    grid-column: span 4;
  }

  .fields-text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .big-tags li {
    padding: 0;
    font-size: 13px;
  }

  .big-tags a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    color: var(--royal);
    transition: background-color 160ms ease;
  }

  .big-tags a:hover,
  .big-tags a:focus-visible {
    background: var(--powder);
    color: var(--royal);
  }

  .fields-link {
    font-size: 15px;
    font-weight: 600;
  }

  .toolkit-card {
    grid-column: span 2;
  }

  .toolkit-card .toolkit-text {
    margin-block: auto;
    padding-bottom: 20px;
  }

  .toolkit-text {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
  }

  .method {
    grid-column: span 4;
    gap: 14px;
  }

  .method-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
  }

  .method-steps li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.6);
  }

  .method-step-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  .method-step-title {
    font-family: var(--font-accent);
    font-size: 22px;
    line-height: 1.1;
  }

  .method-step-text {
    font-size: 13px;
    line-height: 1.45;
    color: #2a3766;
  }

  @media (max-width: 1000px) {
    .method-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .method-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .method-title {
    font-family: var(--font-accent);
    font-size: 28px;
    line-height: 1.2;
  }

  .method-text {
    font-size: 16px;
    line-height: 1.6;
    color: #2a3766;
  }

  .offscreen {
    grid-column: span 2;
    gap: 18px;
  }

  .offscreen-list {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 16px;
  }

  .offscreen-list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .offscreen-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--powder);
    color: var(--royal);
  }

  .offscreen-title {
    display: block;
    font-family: var(--font-accent);
    font-size: 24px;
    line-height: 1.1;
  }

  .offscreen-text {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .notes-card {
    grid-column: span 6;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    color: var(--royal);
    transition: transform 160ms ease;
  }

  .notes-card:hover {
    transform: translateY(-2px);
  }

  .notes-text {
    font-family: var(--font-accent);
    font-size: 24px;
    line-height: 1.3;
  }

  .notes-link {
    font-size: 15px;
    font-weight: 600;
  }


  .cta {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 40px;
    padding: 48px;
    border-radius: var(--radius-card);
    background: var(--royal);
    color: #fff;
    box-shadow: 0 18px 50px rgba(22, 38, 96, 0.25);
  }

  .cta .mono-label {
    color: rgba(255, 255, 255, 0.75);
  }

  .cta h2 {
    max-width: 860px;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .cta h2 .accent {
    color: var(--bone);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 860px) {
    .about-intro,
    .cta {
      padding: 28px;
    }
  }
</style>
