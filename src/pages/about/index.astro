---
// Used by /about/ and /fr/about/ (src/pages/fr/about/index.astro): every text below comes from `c`.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailCopyButton from '../../components/EmailCopyButton.astro';
import { withBase } from '../../lib/url';
import { HOME } from '../../consts';
import { getLang, localePath } from '../../i18n';

const lang = getLang(Astro.url);
const fr = lang === 'fr';
const cv = fr && HOME.cvFr ? HOME.cvFr : HOME.cv;
const projectCount = (await getCollection('works')).length;

const COPY = {
  en: {
    title: 'Who am I?',
    description: 'Axel DEROBERT, Data Analyst in Lyon: finding the story behind the numbers.',
    sectionLabel: 'About Axel',
    eyebrow: 'Who am I?',
    h1A: 'Finding the ',
    h1B: 'story',
    h1C: ' behind the numbers',
    intro: 'Born and raised in France, I left right after high school to live abroad for nearly ten years: Australia, then Sweden, then the Netherlands. Those experiences made me fluent in English, taught me real independence, and left me with a lasting curiosity: figuring out how things work wherever I land.',
    portrait: 'Portrait of Axel DEROBERT',
    today: 'Today',
    todayText: 'That curiosity has found its playground: <strong>data</strong>. I am training as a Data Analyst with OpenClassrooms, learning to turn raw, messy data into clear decisions a team can act on.',
    toolkit: 'My toolkit',
    toolkitA: 'Python, SQL, Power BI, Tableau: ',
    toolkitB: 'whatever it takes to make data talk.',
    fieldsEyebrow: 'End-to-end analyses',
    onSite: 'on this site',
    fieldsText: 'Across my OpenClassrooms projects, I have taken analyses from raw data to a clear recommendation, always tied to a business decision: where to export, where to invest, which projects to watch.',
    fields: ['Fraud detection', 'Rental investment', 'Market research', 'Education', 'Project management', 'E-commerce', 'Retail', 'Real estate', 'Food security', 'Insurance'],
    seeCases: 'See the case studies →',
    calledHome: 'Called home',
    countries: '4 countries',
    journey: ['France, where I grew up', 'Australia', 'Sweden', 'The Netherlands', 'Back in Lyon, today'],
    languages: 'Native French, fluent English',
    how: 'How I work',
    howTitle: 'Curious first, rigorous always',
    howText: 'I start with questions: what is the data really saying, and what might it be leaving out? Then I check before I conclude. I recompute the key figures from the source and look at units, joins and missing values. Coming back to my projects for this portfolio, that habit sharpened several of my conclusions, and each case study shows how.',
    steps: [
      ['Question', 'What does the business really need to know?'],
      ['Clean', 'Units, joins and gaps, fixed before any chart.'],
      ['Explore', 'Patterns and outliers, tested, not assumed.'],
      ['Story', 'One clear answer a team can act on.'],
    ],
    offscreen: 'Off-screen',
    music: ['Music', 'Listening to it, and making it.'],
    football: ['Football', 'Watching the game, and reading the numbers behind it.'],
    travel: ['Travel', 'Discovering new places, a habit my many trips left me with.'],
    // Places shown as small tags under Travel, one colour per continent (continent name on hover); an empty list hides them.
    placesLabel: 'Places I have travelled to',
    regions: [
      { key: 'asia', label: 'Asia', places: ['Thailand', 'Indonesia', 'Malaysia', 'Singapore', 'South Korea', 'Japan', 'Sri Lanka', 'Philippines'] },
      { key: 'europe', label: 'Europe', places: ['Italy', 'Spain', 'Albania', 'Portugal'] },
      { key: 'americas', label: 'Americas', places: ['United States', 'Mexico', 'Costa Rica', 'Panama', 'Colombia', 'Peru', 'Brazil'] },
    ],
    notes: 'Notes',
    notesText: 'What my projects taught me, from analytical traps to working with AI',
    readNotes: 'Read the notes →',
    lookingFor: "What I'm looking for",
    ctaA: 'A data internship in Lyon or hybrid. You could keep looking. Or get in touch and ',
    ctaB: 'save yourself the time',
    ctaC: '',
    linkedin: "Let's talk on LinkedIn",
    cv: 'Download my CV',
  },
  fr: {
    title: 'Qui suis-je ?',
    description: 'Axel DEROBERT, Data Analyst à Lyon : trouver l’histoire derrière les chiffres.',
    sectionLabel: 'À propos d’Axel',
    eyebrow: 'Qui suis-je ?',
    h1A: 'Trouver l’',
    h1B: 'histoire',
    h1C: ' derrière les chiffres',
    intro: 'Né et grandi en France, je suis parti vivre à l’étranger juste après le lycée, pendant près de 10 ans : l’Australie, puis la Suède, puis les Pays-Bas. Ces expériences m’ont rendu bilingue en anglais, m’ont appris la vraie autonomie et m’ont laissé une curiosité durable : comprendre comment les choses fonctionnent, où que j’arrive.',
    portrait: 'Portrait d’Axel DEROBERT',
    today: 'Aujourd’hui',
    todayText: 'Cette curiosité a trouvé son terrain de jeu : <strong>la data</strong>. Je me forme au métier de Data Analyst avec OpenClassrooms, et j’apprends à transformer des données brutes et désordonnées en décisions claires sur lesquelles une équipe peut agir.',
    toolkit: 'Ma boîte à outils',
    toolkitA: 'Python, SQL, Power BI, Tableau : ',
    toolkitB: 'tout ce qu’il faut pour faire parler les données.',
    fieldsEyebrow: 'Des analyses de bout en bout',
    onSite: 'sur ce site',
    fieldsText: 'Au fil de mes projets OpenClassrooms, j’ai mené des analyses de la donnée brute jusqu’à une recommandation claire, toujours reliée à une décision métier : où exporter, où investir, quels projets surveiller.',
    fields: ['Détection de fraude', 'Investissement locatif', 'Étude de marché', 'Éducation', 'Gestion de projet', 'E-commerce', 'Commerce de détail', 'Immobilier', 'Sécurité alimentaire', 'Assurance'],
    seeCases: 'Voir les études de cas →',
    calledHome: 'Là où j’ai vécu',
    countries: '4 pays',
    journey: ['La France, où j’ai grandi', 'Australie', 'Suède', 'Pays-Bas', 'De retour à Lyon, aujourd’hui'],
    languages: 'Français natif, anglais courant',
    how: 'Ma façon de travailler',
    howTitle: 'La curiosité d’abord, la rigueur toujours',
    howText: 'Je commence par des questions : que disent vraiment les données, et que laissent-elles de côté ? Puis je vérifie avant de conclure. Je recalcule les chiffres clés à partir de la source et je contrôle les unités, les jointures et les valeurs manquantes. En revenant sur mes projets pour ce portfolio, cette habitude a affiné plusieurs de mes conclusions, et chaque étude de cas montre comment.',
    steps: [
      ['Questionner', 'Qu’est-ce que le métier a vraiment besoin de savoir ?'],
      ['Nettoyer', 'Unités, jointures et valeurs manquantes, réglées avant le moindre graphique.'],
      ['Explorer', 'Tendances et valeurs aberrantes, testées, pas supposées.'],
      ['Raconter', 'Une réponse claire sur laquelle une équipe peut agir.'],
    ],
    offscreen: 'Hors écran',
    music: ['Musique', 'L’écouter, et en faire.'],
    football: ['Football', 'Regarder les matchs, et lire les chiffres derrière.'],
    travel: ['Voyage', 'Découvrir de nouveaux endroits, une habitude héritée de mes nombreux voyages.'],
    placesLabel: 'Pays visités',
    regions: [
      { key: 'asia', label: 'Asie', places: ['Thaïlande', 'Indonésie', 'Malaisie', 'Singapour', 'Corée du Sud', 'Japon', 'Sri Lanka', 'Philippines'] },
      { key: 'europe', label: 'Europe', places: ['Italie', 'Espagne', 'Albanie', 'Portugal'] },
      { key: 'americas', label: 'Amériques', places: ['États-Unis', 'Mexique', 'Costa Rica', 'Panama', 'Colombie', 'Pérou', 'Brésil'] },
    ],
    notes: 'Notes',
    notesText: 'Ce que mes projets m’ont appris, des pièges d’analyse au travail avec l’IA',
    readNotes: 'Lire les notes →',
    lookingFor: 'Ce que je recherche',
    ctaA: 'Un stage data à Lyon ou en hybride. Vous pouvez continuer à chercher. Ou m’écrire et ',
    ctaB: 'gagner du temps',
    ctaC: '',
    linkedin: 'Discutons sur LinkedIn',
    cv: 'Télécharger mon CV',
  },
};
const c = COPY[lang];

const journey = [
  { code: 'FR', label: c.journey[0] },
  { code: 'AU', label: c.journey[1] },
  { code: 'SE', label: c.journey[2] },
  { code: 'NL', label: c.journey[3] },
  { code: 'FR', label: c.journey[4], now: true },
];

// One field per case study, in the same order as the Projects page; each tag links to its case study.
const slugs = [
  'counterfeit-banknotes',
  'airbnb-investment-dashboard',
  'poultry-export-markets',
  'student-demographics-dbt',
  'sanitoral-powerbi-dashboard',
  'online-bookshop-sales',
  'bottleneck-stock-sales',
  'french-property-market-sql',
  'global-food-security',
  'home-insurance-sql',
];
const fields = slugs.map((slug, index) => ({ label: c.fields[index], slug }));
const steps = c.steps.map(([title, text], index) => ({ num: String(index + 1).padStart(2, '0'), title, text }));
---

<BaseLayout title={c.title} description={c.description}>
  <div class="page-wrap">
    <section class="bento" aria-label={c.sectionLabel}>
      <div class="card glass about-intro">
        <span class="mono-label">{c.eyebrow}</span>
        <h1 class="page-title">{c.h1A}<span class="accent">{c.h1B}</span>{c.h1C}</h1>
        <p class="page-lead">{c.intro}</p>
      </div>

      <div class="card portrait-card">
        {
          HOME.photo ? (
            <img class="portrait" src={withBase(HOME.photo)} alt={c.portrait} width="480" height="480" />
          ) : (
            <div class="portrait portrait-placeholder">[Your photo]</div>
          )
        }
      </div>

      <div class="card tone-powder today">
        <span class="mono-label">{c.today}</span>
        <p class="today-text" set:html={c.todayText} />
      </div>

      <div class="card tone-bone toolkit-card">
        <span class="mono-label">{c.toolkit}</span>
        <p class="toolkit-text">
          {c.toolkitA}<span class="accent">{c.toolkitB}</span>
        </p>
      </div>

      <div class="card glass fields">
        <div class="card-head">
          <span class="mono-label">{c.fieldsEyebrow}</span>
          <span class="mono-small">{projectCount} {c.onSite}</span>
        </div>
        <p class="fields-text">{c.fieldsText}</p>
        <ul class="tag-row big-tags">
          {
            fields.map((field) => (
              <li>
                <a href={localePath(`/works/${field.slug}/`, lang)}>{field.label}</a>
              </li>
            ))
          }
        </ul>
        <a class="fields-link" href={localePath('/works/', lang)}>{c.seeCases}</a>
      </div>

      <div class="card glass journey-card">
        <div class="card-head">
          <span class="mono-label">{c.calledHome}</span>
          <span class="accent-italic journey-count">{c.countries}</span>
        </div>
        <ol class="journey-list">
          {
            journey.map((stop) => (
              <li class:list={[{ now: stop.now }]}>
                <span class="journey-dot" />
                <span class="journey-code">{stop.code}</span>
                <span>{stop.label}</span>
              </li>
            ))
          }
        </ol>
        <span class="muted-small">{c.languages}</span>
      </div>

      <div class="card tone-bone method">
        <span class="mono-label">{c.how}</span>
        <p class="method-title">{c.howTitle}</p>
        <p class="method-text">{c.howText}</p>
        <ol class="method-steps">
          {
            steps.map((step) => (
              <li>
                <span class="method-step-num">{step.num}</span>
                <span class="method-step-title">{step.title}</span>
                <span class="method-step-text">{step.text}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="card glass offscreen">
        <span class="mono-label">{c.offscreen}</span>
        <ul class="offscreen-list">
          <li>
            <span class="offscreen-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
            </span>
            <span>
              <span class="offscreen-title">{c.music[0]}</span>
              <span class="offscreen-text">{c.music[1]}</span>
            </span>
          </li>
          <li>
            <span class="offscreen-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7l4.5 3.3-1.7 5.2H9.2L7.5 10.3z"></path></svg>
            </span>
            <span>
              <span class="offscreen-title">{c.football[0]}</span>
              <span class="offscreen-text">{c.football[1]}</span>
            </span>
          </li>
          <li>
            <span class="offscreen-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18"></path><path d="M12 3a14 14 0 0 0 0 18"></path></svg>
            </span>
            <span>
              <span class="offscreen-title">{c.travel[0]}</span>
              <span class="offscreen-text">{c.travel[1]}</span>
            </span>
          </li>
        </ul>
        {
          c.regions.length > 0 && (
            <ul class="places" aria-label={c.placesLabel}>
              {c.regions.flatMap((region) =>
                region.places.map((place) => (
                  <li class={`region-${region.key}`} title={region.label}>
                    {place}
                  </li>
                )),
              )}
            </ul>
          )
        }
      </div>

      <a class="card glass notes-card" href={localePath('/blog/', lang)}>
        <span class="mono-label">{c.notes}</span>
        <p class="notes-text">{c.notesText}</p>
        <span class="notes-link">{c.readNotes}</span>
      </a>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <span class="mono-label">{c.lookingFor}</span>
      <h2 id="cta-title">
        {c.ctaA}<span class="accent">{c.ctaB}</span>{c.ctaC}
      </h2>
      <div class="cta-actions">
        <a class="btn btn-powder" href={HOME.linkedin} target="_blank" rel="noopener noreferrer">{c.linkedin}</a>
        {cv && <a class="btn btn-white" href={withBase(cv)} download>{c.cv}</a>}
        {HOME.email && <EmailCopyButton email={HOME.email} />}
        <a class="btn btn-ghost-light" href={HOME.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-intro {
    grid-column: span 4;
    justify-content: center;
    gap: 20px;
    padding: 40px;
  }

  .portrait-card {
    grid-column: span 2;
    padding: 0;
    overflow: hidden;
    background: var(--powder);
  }

  .portrait {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
  }

  .portrait-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .today {
    grid-column: span 4;
    justify-content: center;
  }

  .today-text {
    font-family: var(--font-accent);
    font-size: 26px;
    line-height: 1.35;
  }

  .today-text strong {
    font-family: var(--font-body);
    font-size: 0.9em;
  }

  .journey-card {
    grid-column: span 2;
    gap: 22px;
  }

  .journey-card .muted-small {
    margin-top: auto;
  }

  .journey-count {
    font-size: 20px;
  }

  .journey-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .journey-list li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    font-weight: 500;
  }

  .journey-list li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 18px;
    bottom: -14px;
    width: 2px;
    background: rgba(22, 38, 96, 0.18);
  }

  .journey-dot {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--royal);
  }

  .journey-list li.now {
    font-weight: 700;
  }

  .journey-list li.now .journey-dot {
    background: var(--royal);
    box-shadow: 0 0 0 4px rgba(22, 38, 96, 0.15);
  }

  .journey-code {
    width: 26px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  .fields {
    grid-column: span 4;
  }

  .fields-text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .big-tags li {
    padding: 0;
    font-size: 13px;
  }

  .big-tags a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    color: var(--royal);
    transition: background-color 160ms ease;
  }

  .big-tags a:hover,
  .big-tags a:focus-visible {
    background: var(--powder);
    color: var(--royal);
  }

  .fields-link {
    font-size: 15px;
    font-weight: 600;
  }

  .toolkit-card {
    grid-column: span 2;
  }

  .toolkit-card .toolkit-text {
    margin-block: auto;
    padding-bottom: 20px;
  }

  .toolkit-text {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
  }

  .method {
    grid-column: span 4;
    gap: 14px;
  }

  /* Two columns: keeps this card as tall as the Off-screen card next to it. */
  .method-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
  }

  .method-steps li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.6);
  }

  .method-step-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  .method-step-title {
    font-family: var(--font-accent);
    font-size: 22px;
    line-height: 1.1;
  }

  .method-step-text {
    font-size: 13px;
    line-height: 1.45;
    color: #2a3766;
  }

  @media (max-width: 480px) {
    .method-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .method-title {
    font-family: var(--font-accent);
    font-size: 28px;
    line-height: 1.2;
  }

  .method-text {
    font-size: 16px;
    line-height: 1.6;
    color: #2a3766;
  }

  .offscreen {
    grid-column: span 2;
    gap: 18px;
  }

  .offscreen-list {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 16px;
  }

  .offscreen-list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .offscreen-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--powder);
    color: var(--royal);
  }

  .offscreen-title {
    display: block;
    font-family: var(--font-accent);
    font-size: 24px;
    line-height: 1.1;
  }

  .offscreen-text {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .places {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .places li {
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--royal);
  }

  /* One soft tint per continent, all readable with navy text. */
  .region-asia {
    background: #d0e6fd;
  }

  .region-europe {
    background: #eddcc2;
  }

  .region-americas {
    background: #d5e8d0;
  }

  .notes-card {
    grid-column: span 6;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    color: var(--royal);
    transition: transform 160ms ease;
  }

  .notes-card:hover {
    transform: translateY(-2px);
  }

  .notes-text {
    font-family: var(--font-accent);
    font-size: 24px;
    line-height: 1.3;
  }

  .notes-link {
    font-size: 15px;
    font-weight: 600;
  }


  .cta {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 40px;
    padding: 48px;
    border-radius: var(--radius-card);
    background: var(--royal);
    color: #fff;
    box-shadow: 0 18px 50px rgba(22, 38, 96, 0.25);
  }

  .cta .mono-label {
    color: rgba(255, 255, 255, 0.75);
  }

  .cta h2 {
    max-width: 860px;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .cta h2 .accent {
    color: var(--bone);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 860px) {
    .about-intro,
    .cta {
      padding: 28px;
    }
  }
</style>
