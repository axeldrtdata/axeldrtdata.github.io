---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/bento.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { SITE, SITE_FR, NAV_ITEMS } from '../consts';
import { getLang, useT, localePath, switchPath } from '../i18n';
import CodeCopy from '../components/CodeCopy.astro';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const fr = lang === 'fr';
const siteName = SITE.title;
const hasNotes = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;
const navItems = NAV_ITEMS.filter((item) => hasNotes || item.href !== '/blog/');
const [firstName, ...lastNames] = siteName.split(' ');
const lastRefresh = new Date().toLocaleDateString(fr ? 'fr-FR' : 'en-GB', { month: 'short', year: 'numeric' });

const {
  title = siteName,
  description = fr ? SITE_FR.description : SITE.description,
  ogType = 'website',
  image,
} = Astro.props;

// `Astro.site` comes from `site` in astro.config.mjs; fall back to the
// request URL during dev so canonical/OG links still resolve.
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBase(SITE.ogImage), siteBase);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = localePath(href, lang);
  return href === '/' ? currentPath === full : currentPath.startsWith(full);
};
const enURL = new URL(switchPath(Astro.url, 'en'), siteBase);
const frURL = new URL(switchPath(Astro.url, 'fr'), siteBase);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="fr" href={frURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('/rss.xml')} />
    <title>{fullTitle}</title>

    {/* Astro comment syntax — an HTML comment here would ship on every page. */}
    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {/* Open Graph wants `ja_JP`, not the `ja-JP` of `<html lang>`. */}
    <meta property="og:locale" content={fr ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={fr ? 'en_GB' : 'fr_FR'} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    {/* Twitter */}
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      // Runs before paint on the initial load, and again on `astro:after-swap`
      // because the router resets `<html>` attributes during soft navigation.
      // IIFE so top-level consts can't clash if the script ever re-runs.
      (() => {
        const applyTheme = () => {
          document.documentElement.dataset.theme = 'light';
        };
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localePath('/', lang)} aria-label={t('nav.brandHome', { site: siteName })}>
        <span class="brand-first">{firstName}</span>
        <span class="brand-last">{lastNames.join(' ')}</span>
      </a>
      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          navItems.map((item) => (
            <a href={localePath(item.href, lang)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.labelKey ? t(item.labelKey) : item.label}
            </a>
          ))
        }
      </nav>
      <div class="header-actions">
        <div class="lang-switch" role="group" aria-label={fr ? 'Langue' : 'Language'}>
          <a
            class:list={['lang', { 'is-active': !fr }]}
            href={switchPath(Astro.url, 'en')}
            hreflang="en"
            lang="en"
            aria-current={fr ? undefined : 'true'}
            title="English version"
            data-astro-reload
          >EN</a>
          <a
            class:list={['lang', { 'is-active': fr }]}
            href={switchPath(Astro.url, 'fr')}
            hreflang="fr"
            lang="fr"
            aria-current={fr ? 'true' : undefined}
            title="Version française"
            data-astro-reload
          >FR</a>
        </div>
        <a class="header-cta" href={`${localePath('/', lang)}#contact`}>{fr ? 'Me contacter' : 'Contact me'}</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {siteName} · {fr ? SITE_FR.footerText : SITE.footerText}</p>
      <p class="footer-status">
        <span class="footer-dot" aria-hidden="true"></span>
        {fr ? `Dernière mise à jour : ${lastRefresh} · tous les pipelines au vert` : `Last refresh: ${lastRefresh} · all pipelines green`}
      </p>
      <SocialLinks />
    </footer>

    <CodeCopy />

    <script>
      // Delegated to `document` so the handler survives view-transition swaps
      // that replace the toggle button element.
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) {
          return;
        }
        const current = document.documentElement.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
