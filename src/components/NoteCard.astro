---
// One note in the notes list (/blog/ and the tag pages), in the same card style as the homepage.
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import { formatDate } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime?: string;
}

const { post, readingTime } = Astro.props;
const href = withBase(`/blog/${post.id}/`);
---

<article class="card glass note-card">
  <div class="note-card-meta">
    <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate, 'short')}</time>
    {readingTime && <span>· {readingTime}</span>}
  </div>
  <h2 class="note-card-title"><a href={href}>{post.data.title}</a></h2>
  <p class="note-card-text">{post.data.description}</p>
  {post.data.tags.length > 0 && <ul class="tag-row">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
  <a class="note-card-link" href={href}>Read the note →</a>
</article>

<style>
  .note-card {
    grid-column: span 3;
    gap: 14px;
    padding: 30px;
  }

  .note-card-meta {
    display: flex;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  :global(.page-wrap) .note-card-title {
    font-family: var(--font-accent);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
  }

  .note-card-text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .note-card-link {
    margin-top: auto;
    font-size: 15px;
    font-weight: 600;
  }
</style>
