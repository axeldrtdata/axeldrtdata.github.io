---
// Tag pills above the notes list, in the same style as the project filters on /works/.
// Each pill is a link to the tag page; the current one is highlighted.
import { withBase } from '../lib/url';

interface Props {
  tags: { name: string; count: number }[];
  total: number;
  active?: string;
}

const { tags, total, active } = Astro.props;
---

<nav class="note-filters" aria-label="Filter notes by tag">
  <a class="note-filter" href={withBase('/blog/')} aria-current={active ? undefined : 'page'}>
    All <span>{total}</span>
  </a>
  {
    tags.map((tag) => (
      <a
        class="note-filter"
        href={withBase(`/blog/tags/${tag.name}/`)}
        aria-current={tag.name === active ? 'page' : undefined}
      >
        {tag.name} <span>{tag.count}</span>
      </a>
    ))
  }
</nav>

<style>
  .note-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  :global(.page-wrap) .note-filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    color: var(--royal);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .note-filter span {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: rgba(22, 38, 96, 0.08);
    font-size: 12px;
  }

  :global(.page-wrap) .note-filter:hover {
    background: #fff;
    color: var(--royal);
  }

  :global(.page-wrap) .note-filter[aria-current='page'] {
    background: var(--royal);
    border-color: var(--royal);
    color: #fff;
  }

  .note-filter[aria-current='page'] span {
    background: rgba(255, 255, 255, 0.18);
  }
</style>
