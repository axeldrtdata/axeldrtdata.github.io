---
// Interactive Tableau Public dashboard, loaded only on click to keep the page fast.
// On small screens, the static image stays and a link opens the dashboard full screen.
// Usage in MDX:
//   <TableauEmbed workbook="AirbnbInvestmentDashboard" view="World" profile="axel.derobert" poster={img} alt="…" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLang } from '../../i18n';

interface Props {
  workbook: string;
  view: string;
  profile: string;
  poster: ImageMetadata;
  alt: string;
  title?: string;
  /** Fixed size of the dashboard in Tableau (Dashboard > Size > Fixed size). */
  width?: number;
  height?: number;
}

const fr = getLang(Astro.url) === 'fr';
const { workbook, view, profile, poster, alt, title = fr ? 'Dashboard interactif' : 'Live dashboard', width = 1400, height = 900 } = Astro.props;
// Tabs bar above the dashboard and toolbar below it, added by Tableau Public.
const chrome = 62;
const embedUrl = `https://public.tableau.com/views/${workbook}/${view}?:showVizHome=no&:embed=true&:tabs=yes&:toolbar=yes&:device=desktop&:language=en-US`;
const pageUrl = `https://public.tableau.com/app/profile/${profile}/viz/${workbook}/${view}`;
---

<figure class="tableau glass" data-tableau-embed data-src={embedUrl} data-width={width} data-height={height + chrome} data-iframe-title={fr ? 'Dashboard Tableau interactif' : 'Interactive Tableau dashboard'}>
  <figcaption class="tableau-head">
    <span class="tableau-title">{title}</span>
    <a class="tableau-open" href={pageUrl} target="_blank" rel="noopener noreferrer">{fr ? 'Ouvrir sur Tableau Public ↗' : 'Open on Tableau Public ↗'}</a>
  </figcaption>
  <div class="tableau-stage">
    <Image class="tableau-poster" src={poster} alt={alt} widths={[700, 1100, 1600, 2200]} sizes="(min-width: 1200px) 1160px, 100vw" />
    <button class="tableau-launch" type="button" data-tableau-launch>
      <span class="launch-dot" aria-hidden="true"></span>
      {fr ? 'Lancer le dashboard interactif' : 'Launch the interactive dashboard'}
    </button>
  </div>
  <p class="tableau-note">{fr ? 'Filtres, curseur et onglets fonctionnent. À voir de préférence sur ordinateur.' : 'Filters, slider and tabs all work. Best viewed on a computer.'}</p>
</figure>

<script>
  function initTableauEmbeds() {
    document.querySelectorAll<HTMLElement>('[data-tableau-embed]').forEach((embed) => {
      const button = embed.querySelector<HTMLButtonElement>('[data-tableau-launch]');
      const stage = embed.querySelector<HTMLElement>('.tableau-stage');
      if (!button || !stage || button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const width = Number(embed.dataset.width);
        const height = Number(embed.dataset.height);
        const iframe = document.createElement('iframe');
        iframe.src = embed.dataset.src ?? '';
        iframe.title = embed.dataset.iframeTitle ?? 'Interactive Tableau dashboard';
        iframe.allowFullscreen = true;
        iframe.width = String(width);
        iframe.height = String(height);
        stage.replaceChildren(iframe);
        embed.classList.add('is-live');

        // Render the dashboard at its real size, then scale it down to fit the page.
        const fit = () => {
          const scale = Math.min(1, stage.clientWidth / width);
          iframe.style.transform = `scale(${scale})`;
          stage.style.height = `${Math.round(height * scale)}px`;
        };
        fit();
        new ResizeObserver(fit).observe(stage);
      });
    });
  }

  document.addEventListener('astro:page-load', initTableauEmbeds);
</script>

<style>
  .tableau {
    position: relative;
    left: 50%;
    width: min(var(--content-width), calc(100vw - var(--page-pad) * 2));
    margin: 2.5rem 0;
    padding: 22px;
    border-radius: var(--radius-card);
    background: #fff;
    transform: translateX(-50%);
  }

  .tableau-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  .tableau-title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .tableau-open {
    font-size: 14px;
    font-weight: 600;
    color: var(--royal);
    text-decoration: none;
  }

  .tableau-stage {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
  }

  .tableau-poster {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.9);
  }

  .tableau-launch {
    position: absolute;
    left: 50%;
    top: 50%;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 26px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--royal);
    color: #fff;
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    box-shadow: 0 16px 40px rgba(22, 38, 96, 0.35);
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition: transform 160ms ease;
  }

  .tableau-launch:hover {
    transform: translate(-50%, -52%);
  }

  .launch-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #5bd69a;
    box-shadow: 0 0 0 4px rgba(91, 214, 154, 0.25);
  }

  .tableau.is-live .tableau-stage {
    border-radius: 6px;
  }

  .tableau-stage :global(iframe) {
    display: block;
    border: 0;
    transform-origin: top left;
  }

  .tableau-note {
    margin: 12px 0 0;
    font-size: 14px;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .tableau-launch,
    .tableau-note {
      display: none;
    }
  }
</style>
