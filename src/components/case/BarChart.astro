---
// Horizontal bar chart drawn in HTML/CSS, so it matches the site's fonts and colours.
// Usage in MDX:
// <BarChart title="Markup by product type" unit="%" data={[{ label: 'Cognac', value: 82.3 }]} />
interface Props {
  title: string;
  data: { label: string; value: number; highlight?: boolean }[];
  unit?: string;
  caption?: string;
  decimals?: number;
  /** Optional reference line drawn across every bar (e.g. Kaiser criterion), with its legend. */
  threshold?: { value: number; label: string };
}

import { getLang } from '../../i18n';
const { title, data, unit = '', caption, decimals = 1, threshold } = Astro.props;
const fr = getLang(Astro.url) === 'fr';
const max = Math.max(...data.map((item) => item.value));
// French puts a narrow no-break space before % and €, and a comma before decimals.
const format = (value: number) => {
  const number = value.toLocaleString(fr ? 'fr-FR' : 'en-GB', { minimumFractionDigits: decimals, maximumFractionDigits: decimals })
    // a regular no-break space between thousands: the narrow one is almost invisible in this font
    .replace(/\u202f/g, '\u00a0');
  return fr && unit.trim() ? `${number}\u202f${unit.trim()}` : `${number}${unit}`;
};
---

<figure class="chart glass">
  <figcaption class="chart-title">{title}</figcaption>
  <ul class="chart-rows">
    {
      data.map((item) => (
        <li class:list={['chart-row', { 'is-highlight': item.highlight }]}>
          <span class="chart-label">{item.label}</span>
          <span class="chart-track">
            <span class="chart-bar" style={`width: ${(item.value / max) * 100}%`} />
            {threshold && <span class="chart-threshold" style={`left: ${(threshold.value / max) * 100}%`} />}
          </span>
          <span class="chart-value">{format(item.value)}</span>
        </li>
      ))
    }
  </ul>
  {
    threshold && (
      <p class="chart-legend">
        <span class="chart-legend-line" aria-hidden="true" />
        {threshold.label}
      </p>
    )
  }
  {caption && <p class="chart-caption">{caption}</p>}
</figure>

<style>
  .chart {
    margin: 2.5rem 0;
    padding: 26px 28px;
    border-radius: var(--radius-card);
  }

  .chart-title {
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .chart-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chart-row {
    display: grid;
    grid-template-columns: minmax(90px, 30%) 1fr 64px;
    align-items: center;
    gap: 14px;
    margin: 0;
  }

  .chart-label {
    font-size: 15px;
    font-weight: 500;
    color: var(--royal);
  }

  .chart-track {
    position: relative;
    height: 14px;
    border-radius: var(--radius-pill);
    background: rgba(22, 38, 96, 0.06);
  }

  .chart-bar {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--steel);
  }

  .chart-threshold {
    position: absolute;
    top: -7px;
    bottom: -7px;
    border-left: 2px dashed var(--gold, #e2a93b);
  }

  .chart-legend {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  .chart-legend-line {
    width: 0;
    height: 16px;
    border-left: 2px dashed var(--gold, #e2a93b);
  }

  .is-highlight .chart-bar {
    background: var(--royal);
  }

  .chart-value {
    font-family: var(--font-mono);
    font-size: 13px;
    text-align: right;
    color: var(--royal);
  }

  .chart-caption {
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>