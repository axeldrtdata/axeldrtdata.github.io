---
// An image from the project (chart, map, screenshot) with a caption, in a glass card.
// Usage in MDX:
//   import mapImage from './map.png';
//   <Figure src={mapImage} alt="World map of the four clusters" caption="…" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  title?: string;
  /** Break out of the text column to use the full page width (dashboards, maps). */
  wide?: boolean;
}

const { src, alt, caption, title, wide = false } = Astro.props;
---

<figure class:list={['figure', 'glass', { 'is-wide': wide }]}>
  {title && <figcaption class="figure-title">{title}</figcaption>}
  <Image src={src} alt={alt} widths={[700, 1100, 1600, 2200]} sizes={wide ? '(min-width: 1200px) 1160px, 100vw' : '(min-width: 860px) 760px, 100vw'} />
  {caption && <p class="figure-caption">{caption}</p>}
</figure>

<style>
  .figure {
    margin: 2.5rem 0;
    padding: 22px;
    border-radius: var(--radius-card);
    background: #fff;
  }

  .figure.is-wide {
    position: relative;
    left: 50%;
    width: min(var(--content-width), calc(100vw - var(--page-pad) * 2));
    transform: translateX(-50%);
  }

  .figure-title {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .figure-caption {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>
