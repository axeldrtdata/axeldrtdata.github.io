---
// An image from the project (chart, map, screenshot) with a caption, in a glass card.
// Usage in MDX:
//   import mapImage from './map.png';
//   <Figure src={mapImage} alt="World map of the four clusters" caption="…" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  title?: string;
}

const { src, alt, caption, title } = Astro.props;
---

<figure class="figure glass">
  {title && <figcaption class="figure-title">{title}</figcaption>}
  <Image src={src} alt={alt} widths={[700, 1100, 1600]} sizes="(min-width: 860px) 760px, 100vw" />
  {caption && <p class="figure-caption">{caption}</p>}
</figure>

<style>
  .figure {
    margin: 2.5rem 0;
    padding: 22px;
    border-radius: var(--radius-card);
    background: #fff;
  }

  .figure-title {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .figure-caption {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>
